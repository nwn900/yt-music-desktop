{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Music",
  "version": "0.1.3",
  "identifier": "com.ytmusic.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "mini",
        "url": "mini.html",
        "title": "YouTube Music — Mini Player",
        "width": 400,
        "height": 150,
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OverlayScrollbarFlashAfterAnyScrollUpdate,CalculateNativeWinOcclusion,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "remote-ytm"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}